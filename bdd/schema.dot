digraph ShopWise {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", label="ShopWise — modèle relationnel", labelloc=t, fontsize=22, nodesep=0.6, ranksep=0.9];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#52796f"];
  shop [label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1d705e"><FONT COLOR="white"><B>SHOP</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR></TABLE> >];
  customer [label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1d705e"><FONT COLOR="white"><B>CUSTOMER</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> shop_id</TD></TR><TR><TD ALIGN="LEFT">name, email, phone</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE> >];
  appointment [label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1d705e"><FONT COLOR="white"><B>APPOINTMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> customer_id</TD></TR><TR><TD ALIGN="LEFT">appointment_date, appointment_time</TD></TR><TR><TD ALIGN="LEFT">service, status</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE> >];
  loyalty [label=< <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#1d705e"><FONT COLOR="white"><B>LOYALTY_TRANSACTION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> customer_id</TD></TR><TR><TD ALIGN="LEFT"><B>FK UNIQUE</B> appointment_id</TD></TR><TR><TD ALIGN="LEFT">points_delta, reason, created_at</TD></TR></TABLE> >];
  shop -> customer [label="1  vers  N"];
  customer -> appointment [label="1  vers  N"];
  customer -> loyalty [label="1  vers  N"];
  appointment -> loyalty [label="0..1 récompense"];
}
